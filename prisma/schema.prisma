generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  ownedSpaces      FamilySpace[]
  spaceMemberships SpaceMembership[]
  claimedPerson    Person?
}

// ==================== FAMILY SPACE ====================

model FamilySpace {
  id        String   @id @default(cuid())
  name      String   // "The Rahman Family"
  slug      String   @unique // "rahman-family"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relationships
  members       SpaceMembership[]
  persons       Person[]
  relationships Relationship[]
  weddingEvents WeddingEvent[]
}

model SpaceMembership {
  id   String          @id @default(cuid())
  role SpaceMemberRole @default(MEMBER)

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  familySpaceId String
  familySpace   FamilySpace @relation(fields: [familySpaceId], references: [id], onDelete: Cascade)

  // Which person in the tree is this user?
  linkedPersonId String? @unique
  linkedPerson   Person? @relation(fields: [linkedPersonId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, familySpaceId])
}

enum SpaceMemberRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

// ==================== PERSON (Family Tree Node) ====================

model Person {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String?
  gender        Gender?
  birthDate     DateTime?
  deathDate     DateTime?
  birthPlace    String?
  profilePhotoUrl String?
  bio           String?  // Short bio

  // Claim status
  status        ClaimStatus @default(UNCLAIMED)
  inviteEmail   String?
  invitedAt     DateTime?

  // Belongs to which family space
  familySpaceId String
  familySpace   FamilySpace @relation(fields: [familySpaceId], references: [id], onDelete: Cascade)

  // If claimed, linked to user
  claimedByUserId String? @unique
  claimedByUser   User?   @relation(fields: [claimedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  biography        Biography?
  spaceMembership  SpaceMembership?
  
  relationshipsAs1 Relationship[] @relation("Person1")
  relationshipsAs2 Relationship[] @relation("Person2")

  // Wedding
  weddingsAsPerson1 WeddingEvent[] @relation("WeddingPerson1")
  weddingsAsPerson2 WeddingEvent[] @relation("WeddingPerson2")
  guestListEntries  GuestListEntry[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ClaimStatus {
  UNCLAIMED
  INVITED
  CLAIMED
}

// ==================== RELATIONSHIPS ====================

model Relationship {
  id   String           @id @default(cuid())
  type RelationshipType

  person1Id String
  person1   Person @relation("Person1", fields: [person1Id], references: [id], onDelete: Cascade)

  person2Id String
  person2   Person @relation("Person2", fields: [person2Id], references: [id], onDelete: Cascade)

  // For spouse relationships
  marriageDate DateTime?
  divorceDate  DateTime?

  familySpaceId String
  familySpace   FamilySpace @relation(fields: [familySpaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([person1Id, person2Id, type])
}

enum RelationshipType {
  PARENT_CHILD // person1 is parent of person2
  SPOUSE
}

// ==================== BIOGRAPHY ====================

model Biography {
  id       String @id @default(cuid())
  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  sections BiographySection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BiographySection {
  id          String             @id @default(cuid())
  sectionType BiographySectionType
  sortOrder   Int                @default(0)
  visibility  Visibility         @default(FAMILY)

  biographyId String
  biography   Biography @relation(fields: [biographyId], references: [id], onDelete: Cascade)

  subsections BiographySubsection[]

  @@unique([biographyId, sectionType])
}

enum BiographySectionType {
  FAMILY
  FRIENDS
  RELATIONSHIP
  TRADITIONS
  ACTIVITIES
  PLACES
  EDUCATION
  CAREER
  TIMELINE
  AWARDS
  PHOTOS
  MISCELLANEOUS
}

model BiographySubsection {
  id        String @id @default(cuid())
  title     String // "Elementary School", "College Friends", etc.
  content   String? // Rich text content
  sortOrder Int    @default(0)

  sectionId String
  section   BiographySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  entries BiographyEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BiographyEntry {
  id        String   @id @default(cuid())
  title     String?
  content   String?  // Rich text
  date      DateTime?
  location  String?
  photoUrls String?  // JSON array of URLs

  subsectionId String
  subsection   BiographySubsection @relation(fields: [subsectionId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Visibility {
  PRIVATE
  FAMILY
  PUBLIC
}

// ==================== WEDDING MODULE ====================

model WeddingEvent {
  id       String   @id @default(cuid())
  name     String   // "Ahmad & Sarah's Wedding"
  date     DateTime?
  venue    String?
  notes    String?

  familySpaceId String
  familySpace   FamilySpace @relation(fields: [familySpaceId], references: [id], onDelete: Cascade)

  // The couple
  person1Id String
  person1   Person @relation("WeddingPerson1", fields: [person1Id], references: [id])
  
  person2Id String
  person2   Person @relation("WeddingPerson2", fields: [person2Id], references: [id])

  guestLists GuestList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuestList {
  id   String @id @default(cuid())
  name String // "Groom's Side", "Bride's Side", "Friends"

  weddingEventId String
  weddingEvent   WeddingEvent @relation(fields: [weddingEventId], references: [id], onDelete: Cascade)

  entries GuestListEntry[]

  createdAt DateTime @default(now())
}

model GuestListEntry {
  id String @id @default(cuid())

  // Either from tree OR manual entry
  personId    String?
  person      Person? @relation(fields: [personId], references: [id])
  
  // For guests not in family tree
  manualName  String?
  manualEmail String?
  manualPhone String?

  rsvpStatus  RsvpStatus @default(PENDING)
  plusOne     Boolean    @default(false)
  plusOneName String?
  
  dietaryRestrictions String?
  tableAssignment     String?
  notes               String?

  guestListId String
  guestList   GuestList @relation(fields: [guestListId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
}
